{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tenantdeck",
  "type": "object",
  "required": ["replicaCount", "image", "service", "config"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["registry", "repository", "pullPolicy"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "contains": { "const": "ALL" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "probes": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "config": {
      "type": "object",
      "required": ["externalURL", "oidc", "session", "upstream"],
      "properties": {
        "externalURL": { "type": "string", "minLength": 1 },
        "listenAddr": { "type": "string" },
        "insecure": { "type": "boolean" },
        "oidc": {
          "type": "object",
          "required": ["issuerURL", "clientID", "existingSecret"],
          "properties": {
            "issuerURL": { "type": "string", "minLength": 1 },
            "clientID": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string", "minLength": 1 },
            "existingSecretKey": { "type": "string", "minLength": 1 },
            "scopes": { "type": "string" }
          }
        },
        "session": {
          "type": "object",
          "required": ["redis", "existingSecretEncryptionKey"],
          "properties": {
            "redis": {
              "type": "object",
              "required": ["addr"],
              "properties": {
                "addr": { "type": "string", "minLength": 1 },
                "username": { "type": "string" },
                "existingSecretPassword": { "type": "string" },
                "existingSecretPasswordKey": { "type": "string" },
                "tls": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "existingSecretCA": { "type": "string" },
                    "existingSecretCAKey": { "type": "string" }
                  }
                }
              }
            },
            "existingSecretEncryptionKey": { "type": "string", "minLength": 1 },
            "existingSecretEncryptionKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "upstream": {
          "type": "object",
          "required": ["capsuleProxyURL"],
          "properties": {
            "capsuleProxyURL": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "extraEnv": { "type": "array" },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" },
        "trustedProxies": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "object" },
        "egress": { "type": "object" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "tests": { "type": "object" }
  }
}
